<%- include("partials/header") %>

<section class="card narrow">
  <h2>Create an account</h2>
  <% if (error) { %><p class="alert alert-error"><%= error %></p><% } %>
  <form action="/signup" method="POST">
    <label for="name">Display name</label>
    <input id="name" name="name" maxlength="255" required autofocus>
    <label for="user_id">User ID</label>
    <input id="user_id" name="user_id" maxlength="255" required>
    <label for="password">Password</label>
    <input id="password" name="password" type="password" minlength="6" required>
    <button class="btn" type="submit">Sign up</button>
  </form>
  <p class="muted">Already have an account? <a href="/signin">Sign in</a></p>
</section>

<%- include("partials/footer") %>